Create:

touch Dockerfile
nano Dockerfile
sudo systemctl status docker

BUILD AND RUN:

docker build -t nikhilbecomessre/my-first-docker-image:latest .
docker build -t $username/$imagename:$version .
docker images
docker run -d --name $container -p 8080:80 $username/$imagename:$version

DEBUG:

docker ps
docker ps -a
docker logs $container
docker exec -it $container sh
docker inspect $container
