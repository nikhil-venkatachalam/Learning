pipeline {

    agent {
        docker {
            image 'nikhilbecomessre/jenkinagentv1:latest'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Backend Build') {
            steps {
                dir('food-delivery-3-tier-source-code/backend') {
                    sh '''
                        npm install
                        echo "Backend dependencies installed successfully"
                    '''
                }
            }
        }

        stage('Frontend Build') {
            steps {
                dir('food-delivery-3-tier-source-code/frontend') {
                    sh '''
                        npm install
                        npm run build
                        echo "Frontend build completed successfully"
                    '''
                }
            }
        }

        stage('Check Workspace') {
            steps {
                sh '''
                    echo "Current directory:"
                    pwd

                    echo "Workspace files:"
                    ls -la

                    echo "Dockerfiles:"
                    find . -name Dockerfile -print
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    docker build \
                    -t nikhilbecomessre/food-delivery-backend:${BUILD_NUMBER} \
                    ./food-delivery-3-tier-source-code/backend

                    docker build \
                    -t nikhilbecomessre/food-delivery-frontend:${BUILD_NUMBER} \
                    ./food-delivery-3-tier-source-code/frontend
                '''
            }
        }

        stage('Check Docker Images') {
            steps {
                sh '''
                    docker images | grep food-delivery
                '''
            }
        }

        stage('Push Docker Images') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'Docker-cred') {

                        docker.image(
                            "nikhilbecomessre/food-delivery-backend:${BUILD_NUMBER}"
                        ).push()

                        docker.image(
                            "nikhilbecomessre/food-delivery-frontend:${BUILD_NUMBER}"
                        ).push()
                    }
                }
            }
        }
    }

    post {

        success {
            echo 'Food Delivery CI Pipeline completed successfully!'
        }

        failure {
            echo 'Food Delivery CI Pipeline failed!'
        }

        always {
            echo "Pipeline Build Number: ${BUILD_NUMBER}"
        }
    }
}
